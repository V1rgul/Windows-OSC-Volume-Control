<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Windows-OSC-Volume-Control</AssemblyName>
    <RootNamespace>WindowsOscVolumeControl</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Icon\app\ok.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" Exclude="src\**\obj\**\*;src\**\bin\**\*;src\Osc\SharpOSC\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App\App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
    <Page Include="src\UI\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="src\UI\Tray\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="src\UI\Config\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="src\UI\Osd\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="src\UI\Wpf\Controls\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="src\UI\Wpf\Resources\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\Icon\app\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\x32-catalog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="src\Osc\SharpOSC\Properties\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm">
      <Version>8.4.2</Version>
    </PackageReference>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all" />
    <ProjectReference Include="src\Osc\SharpOSC.csproj" />
  </ItemGroup>

  <!-- Release: framework-dependent publish → small zip; target PC needs .NET 10 Desktop runtime. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ReleasePublishDir>$(MSBuildProjectDirectory)\bin\Release\publish-zip</ReleasePublishDir>
    <ReleaseZipFile>$(MSBuildProjectDirectory)\bin\Release\$(AssemblyName)-Release.zip</ReleaseZipFile>
  </PropertyGroup>

  <Target Name="CreateReleaseZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(ReleasePublishDir)" Condition="Exists('$(ReleasePublishDir)')" />
    <MakeDir Directories="$(ReleasePublishDir)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFile)&quot; -c Release -o &quot;$(ReleasePublishDir)&quot; --no-build" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Delete Files="$(ReleasePublishDir)\$(AssemblyName).pdb" Condition="Exists('$(ReleasePublishDir)\$(AssemblyName).pdb')" />
    <ZipDirectory SourceDirectory="$(ReleasePublishDir)" DestinationFile="$(ReleaseZipFile)" Overwrite="true" />
    <RemoveDir Directories="$(ReleasePublishDir)" />
    <Message Text="Release zip created: $(ReleaseZipFile)" Importance="high" />
  </Target>

</Project>
