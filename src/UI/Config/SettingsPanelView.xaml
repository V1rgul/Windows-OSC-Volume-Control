<UserControl
	x:Class="WindowsOscVolumeControl.UI.Config.SettingsPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:WindowsOscVolumeControl.UI.Config"
	xmlns:wpf="clr-namespace:WindowsOscVolumeControl.UI.Wpf.Controls">
	<Border Padding="0">
		<wpf:SmoothScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="0,0,8,8" Grid.IsSharedSizeScope="True">
				<GroupBox Header="Autostart" Margin="0,0,0,8" Padding="0">
					<StackPanel Margin="8,4,8,8" Orientation="Vertical">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Button
								Grid.Column="0"
								Margin="0,0,4,0"
								Padding="12,6"
								MinHeight="32"
								VerticalAlignment="Stretch"
								VerticalContentAlignment="Center"
								HorizontalAlignment="Stretch"
								Command="{Binding registerAutostartCommand}">
								Register
							</Button>
							<Grid
								Grid.Column="1"
								Margin="4,0,0,0"
								HorizontalAlignment="Stretch"
								MinHeight="32"
								VerticalAlignment="Stretch">
								<Border
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									Background="{DynamicResource ControlFillColorDefaultBrush}"
									BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
									BorderThickness="1"
									CornerRadius="4"
									SnapsToDevicePixels="True" />
								<Grid VerticalAlignment="Stretch">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Button
										Grid.Column="0"
										Padding="12,6"
										VerticalAlignment="Stretch"
										VerticalContentAlignment="Center"
										HorizontalAlignment="Stretch"
										HorizontalContentAlignment="Center"
										Background="Transparent"
										BorderBrush="Transparent"
										BorderThickness="0"
										Command="{Binding deregisterAutostartCommand}">
										Deregister
									</Button>
									<Grid Grid.Column="1" VerticalAlignment="Stretch">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<Border
											Grid.Column="0"
											Width="1"
											Margin="0,6,0,6"
											HorizontalAlignment="Center"
											VerticalAlignment="Stretch"
											Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
										<Button
											x:Name="ButtonDeregisterAutostartSplitMenu"
											Grid.Column="1"
											MinWidth="30"
											Padding="8,6"
											VerticalAlignment="Stretch"
											VerticalContentAlignment="Center"
											HorizontalAlignment="Stretch"
											Background="Transparent"
											BorderBrush="Transparent"
											BorderThickness="0"
											Click="buttonDeregisterAutostartSplitMenu_Click"
											ToolTip="More autostart options">
											<Button.ContextMenu>
												<ContextMenu>
													<MenuItem Header="Deregister All" Command="{Binding deregisterAllAutostartCommand}" />
												</ContextMenu>
											</Button.ContextMenu>
											<TextBlock
												FontFamily="{DynamicResource SymbolThemeFontFamily}"
												FontSize="12"
												Text="&#xE70D;"
												VerticalAlignment="Center"
												HorizontalAlignment="Center" />
										</Button>
									</Grid>
								</Grid>
							</Grid>
						</Grid>
						<TextBlock x:Name="AutostartFeedbackTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" />
						<TextBox
							x:Name="AutostartFeedbackPathTextBox"
							Margin="0,4,0,0"
							FontSize="12"
							Style="{DynamicResource ConfigReadOnlyDisplayTextBoxStyle}"
							TextWrapping="Wrap"
							AcceptsReturn="True"
							VerticalScrollBarVisibility="Disabled"
							HorizontalScrollBarVisibility="Disabled"
							Visibility="Collapsed" />
					</StackPanel>
				</GroupBox>

				<GroupBox Header="Config file" Margin="0,0,0,8" Padding="0">
					<Grid Margin="8,4,8,8">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBox
							x:Name="ConfigPathTextBox"
							Grid.Row="0"
							Grid.Column="0"
							Style="{DynamicResource ConfigReadOnlyDisplayTextBoxStyle}"
							FontSize="12"
							TextWrapping="Wrap"
							AcceptsReturn="True"
							VerticalScrollBarVisibility="Disabled"
							HorizontalScrollBarVisibility="Disabled"
							Text="{Binding configPathText}"
							Margin="0,0,0,4" />
						<Button
							Grid.Row="0"
							Grid.Column="1"
							Margin="8,0,0,4"
							MinWidth="40"
							Padding="0"
							HorizontalAlignment="Right"
							VerticalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							VerticalContentAlignment="Center"
							Command="{Binding openConfigFolderCommand}"
							ToolTip="Open config folder">
							<TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE838;" />
						</Button>
						<TextBlock x:Name="ConfigFeedbackTextBlock" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" />
					</Grid>
				</GroupBox>

				<GroupBox Header="Connection" Margin="0,0,0,8" Padding="0">
					<Grid Margin="8,4,8,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsLabel" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsUnit" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,4,4" VerticalAlignment="Center" Text="OSC IP" />
						<TextBox x:Name="IpTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4" Style="{DynamicResource ConfigTextBoxValidationStyle}" Text="{Binding oscIpText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
						<TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,4,4" VerticalAlignment="Center" Text="OSC port" />
						<TextBox
							x:Name="PortTextBox"
							Grid.Row="1"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							Margin="0,0,0,4"
							Style="{DynamicResource ConfigNumericTextBoxStyle}"
							Text="{Binding oscPortText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
						<TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,4,4" VerticalAlignment="Center" Text="Query timeout" />
						<TextBox
							x:Name="TimeoutTextBox"
							Grid.Row="2"
							Grid.Column="1"
							Margin="0,0,0,4"
							Style="{DynamicResource ConfigNumericTextBoxStyle}"
							Text="{Binding queryTimeoutText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
						<TextBlock Grid.Row="2" Grid.Column="2" Margin="4,0,0,4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="ms" />
						<TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,4,4" VerticalAlignment="Center" Text="Value cache TTL" />
						<TextBox
							x:Name="CacheTtlTextBox"
							Grid.Row="3"
							Grid.Column="1"
							Margin="0,0,0,4"
							Style="{DynamicResource ConfigNumericTextBoxStyle}"
							Text="{Binding valueCacheTtlText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
						<TextBlock Grid.Row="3" Grid.Column="2" Margin="4,0,0,4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="ms" />

						<!-- Latency probe UI is still window-owned for now -->
						<StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
							<Grid Margin="0,8,0,6" HorizontalAlignment="Stretch" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" MinWidth="48" />
									<ColumnDefinition Width="*" MinWidth="56" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,10,0" Text="Latency" TextAlignment="Left" HorizontalAlignment="Left" />
								<TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,10,0" Text="Ping" TextAlignment="Center" HorizontalAlignment="Stretch" />
								<wpf:OverflowMarquee Grid.Row="0" Grid.Column="2" Margin="0,0,10,0" HorizontalContentAlignment="Stretch" scrollMode="ONLY_ON_HOVER">
									<TextBlock x:Name="OscHeaderTextBlock" FontWeight="SemiBold" Text="{Binding oscHeaderText}" TextAlignment="Center" HorizontalAlignment="Stretch" />
								</wpf:OverflowMarquee>
								<TextBlock Grid.Row="0" Grid.Column="3" FontWeight="SemiBold" Text="" TextAlignment="Center" HorizontalAlignment="Stretch" />

								<TextBlock Grid.Row="1" Grid.Column="0" Margin="0,2,10,0" Text="Min" />
								<TextBlock x:Name="PingMinTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,2,10,0" Text="{Binding pingMinText}" Foreground="{Binding pingMinForeground}" TextAlignment="Right" />
								<TextBlock x:Name="OscMinTextBlock" Grid.Row="1" Grid.Column="2" Margin="0,2,10,0" Text="{Binding oscMinText}" Foreground="{Binding oscMinForeground}" TextAlignment="Right" />
								<TextBlock Grid.Row="1" Grid.Column="3" Margin="0,2,0,0" Text="ms" />

								<TextBlock Grid.Row="2" Grid.Column="0" Margin="0,2,10,0" Text="Median" />
								<TextBlock x:Name="PingMedianTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,2,10,0" Text="{Binding pingMedianText}" Foreground="{Binding pingMedianForeground}" TextAlignment="Right" />
								<TextBlock x:Name="OscMedianTextBlock" Grid.Row="2" Grid.Column="2" Margin="0,2,10,0" Text="{Binding oscMedianText}" Foreground="{Binding oscMedianForeground}" TextAlignment="Right" />
								<TextBlock Grid.Row="2" Grid.Column="3" Margin="0,2,0,0" Text="ms" />

								<TextBlock Grid.Row="3" Grid.Column="0" Margin="0,2,10,0" Text="Max" />
								<TextBlock x:Name="PingMaxTextBlock" Grid.Row="3" Grid.Column="1" Margin="0,2,10,0" Text="{Binding pingMaxText}" Foreground="{Binding pingMaxForeground}" TextAlignment="Right" />
								<TextBlock x:Name="OscMaxTextBlock" Grid.Row="3" Grid.Column="2" Margin="0,2,10,0" Text="{Binding oscMaxText}" Foreground="{Binding oscMaxForeground}" TextAlignment="Right" />
								<TextBlock Grid.Row="3" Grid.Column="3" Margin="0,2,0,0" Text="ms" />

								<TextBlock Grid.Row="4" Grid.Column="0" Margin="0,2,10,0" Text="Responses" />
								<TextBlock x:Name="PingLossTextBlock" Grid.Row="4" Grid.Column="1" Margin="0,2,10,0" Text="{Binding pingLossText}" Foreground="{Binding pingLossForeground}" TextAlignment="Right" />
								<TextBlock x:Name="OscLossTextBlock" Grid.Row="4" Grid.Column="2" Margin="0,2,10,0" Text="{Binding oscLossText}" Foreground="{Binding oscLossForeground}" TextAlignment="Right" />
								<TextBlock x:Name="LossUnitTextBlock" Grid.Row="4" Grid.Column="3" Margin="0,2,0,0" Text="{Binding lossUnitText}" TextAlignment="Left" />
							</Grid>
							<Grid Margin="0,4,0,0" HorizontalAlignment="Stretch">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="/info" />
								<TextBox
									x:Name="InfoResultTextBox"
									Grid.Column="1"
									MinLines="1"
									MaxLines="10"
									Style="{DynamicResource ConfigReadOnlyDisplayTextBoxStyle}"
									FontSize="12"
									TextWrapping="Wrap"
									VerticalScrollBarVisibility="Auto"
									HorizontalScrollBarVisibility="Disabled"
									AcceptsReturn="True" />
							</Grid>
						</StackPanel>
					</Grid>
				</GroupBox>

				<GroupBox Header="OSD" Margin="0,0,0,8" Padding="0">
					<Grid Margin="8,4,8,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsLabel" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsUnit" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,4,4" VerticalAlignment="Center" Text="Height" />
						<TextBox x:Name="OsdHeightTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Style="{DynamicResource ConfigNumericTextBoxStyle}" Text="{Binding osdHeightText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
						<TextBlock Grid.Row="0" Grid.Column="2" Margin="4,0,0,4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="DIP" />
						<TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,4,4" VerticalAlignment="Center" Text="Display duration" />
						<TextBox x:Name="OsdDurationTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Style="{DynamicResource ConfigNumericTextBoxStyle}" Text="{Binding osdDurationText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
						<TextBlock Grid.Row="1" Grid.Column="2" Margin="4,0,0,4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="ms" />
						<TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,4,0" VerticalAlignment="Center" Text="Position" />
						<ComboBox
							x:Name="OsdPositionComboBox"
							Grid.Row="2"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							DisplayMemberPath="label"
							ItemsSource="{x:Static local:OsdAnchorUiChoices.All}"
							SelectedValuePath="value"
							SelectedValue="{Binding osdPosition}" />
					</Grid>
				</GroupBox>

				<GroupBox Header="Hotkeys" Margin="0,0,0,8" Padding="0">
					<Grid Margin="8,4,8,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsLabel" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsUnit" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,4,4" VerticalAlignment="Center" TextWrapping="Wrap" Text="Long-press duration" />
						<TextBox x:Name="HotkeyLongPressMsTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Style="{DynamicResource ConfigNumericTextBoxStyle}" Text="{Binding hotkeyLongPressMsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
						<TextBlock Grid.Row="0" Grid.Column="2" Margin="4,0,0,4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="ms" />
						<CheckBox x:Name="HotkeyOptimizeNonLongPressCheckBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0" IsChecked="{Binding hotkeyOptimizeNonLongPress}">
							<TextBlock TextWrapping="Wrap" Text="Optimize non–long-press hotkeys (fire on key down instead of waiting for key up or duration)" />
						</CheckBox>
						<CheckBox x:Name="HotkeySuppressLongPressOnlyCheckBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0" IsChecked="{Binding hotkeySuppressLongPressOnly}">
							<TextBlock TextWrapping="Wrap" Text="Swallow short presses also for long-press-only hotkeys" />
						</CheckBox>
						<CheckBox x:Name="HotkeyAcceptMacroChordKeyOrderCheckBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0" IsChecked="{Binding hotkeyAcceptMacroChordKeyOrder}">
							<TextBlock TextWrapping="Wrap" Text="Allow modifier key-up before main key (needed when simulated by macros in fixed order)" />
						</CheckBox>
					</Grid>
				</GroupBox>
			</StackPanel>
		</wpf:SmoothScrollViewer>
	</Border>
</UserControl>

