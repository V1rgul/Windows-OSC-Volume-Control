<Window
	x:Class="WindowsOscVolumeControl.UI.Config.ConfigWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:WindowsOscVolumeControl.UI.Config"
	Title="Windows OSC Volume Control - Settings"
	Width="1180"
	Height="820"
	MinWidth="1180"
	MinHeight="700">
	<Grid>
		<Grid Margin="8,0,8,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280" />
				<!-- Bindings column: hotkey row needs ~800+ dip after 280 dip settings + delete strip + card padding. -->
				<ColumnDefinition Width="*" MinWidth="820" />
			</Grid.ColumnDefinitions>
			<local:SettingsPanelView
				x:Name="SettingsPanel"
				Grid.Column="0"
				DataContext="{Binding vm, ValidatesOnNotifyDataErrors=False}" />
			<local:BindingsPanelView
				Grid.Column="1"
				DataContext="{Binding vm, ValidatesOnNotifyDataErrors=False}" />
		</Grid>

		<!-- Footer chrome mirrors a dragged binding card: the drag ghost rasterizes the opaque
		     composited window surface (window background + the card's two ExpanderHeaderBackground
		     tints + 1px stroke) and draws it at dragGhostOpacity. We reproduce that stack here so the
		     footer reads as a real card over the scrolling content instead of a translucent white tint.
		     FooterSurfaceBase.Background (opaque window surface) and FooterChrome.Opacity are set in code-behind. -->
		<Border
			x:Name="FooterChrome"
			VerticalAlignment="Bottom"
			HorizontalAlignment="Stretch"
			Margin="{StaticResource ConfigFooterOuterMargin}"
			Panel.ZIndex="1">
			<Grid>
				<Border x:Name="FooterSurfaceBase" CornerRadius="10" />
				<Border
					CornerRadius="10"
					BorderThickness="1"
					BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
					Background="{DynamicResource ExpanderHeaderBackground}" />
				<Border
					CornerRadius="10"
					BorderThickness="0"
					Background="{DynamicResource ExpanderHeaderBackground}" />
				<DockPanel LastChildFill="False" Margin="8">
					<TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" />
					<Button
						x:Name="ApplySaveAndTestButton"
						DockPanel.Dock="Right"
						Click="buttonApplySaveAndTest_Click"
						DataContext="{Binding vm, ValidatesOnNotifyDataErrors=False}"
						Style="{StaticResource ConfigApplyButtonStyle}">
						<StackPanel Orientation="Horizontal">
							<Ellipse
								x:Name="ApplySaveAndTestSpinner"
								Width="14"
								Height="14"
								Margin="0,0,8,0"
								Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
								StrokeThickness="2"
								Fill="Transparent"
								StrokeDashArray="2.2 3.8"
								Visibility="Collapsed"
								RenderTransformOrigin="0.5,0.5">
								<Ellipse.RenderTransform>
									<RotateTransform Angle="0" />
								</Ellipse.RenderTransform>
							</Ellipse>
							<TextBlock
								x:Name="ApplySaveAndTestButtonText"
								VerticalAlignment="Center"
								Text="Apply, save and test" />
						</StackPanel>
					</Button>
				</DockPanel>
			</Grid>
		</Border>
	</Grid>
</Window>
