<Window
	x:Class="WindowsOscVolumeControl.UI.Config.ConfigWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:WindowsOscVolumeControl.UI.Config"
	Title="Windows OSC Volume Control - Settings"
	Width="1180"
	Height="820"
	MinWidth="1180"
	MinHeight="700"
	ThemeMode="System">
	<DockPanel>
		<Border DockPanel.Dock="Bottom" Padding="8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
			<DockPanel LastChildFill="False">
				<TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" />
				<Button
					DockPanel.Dock="Right"
					Padding="18,8"
					FontWeight="SemiBold"
					Style="{DynamicResource AccentButtonStyle}"
					Click="buttonApplySaveAndTest_Click">
					Apply, save and test
				</Button>
			</DockPanel>
		</Border>

		<Grid Margin="8,0,8,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280" />
				<!-- Bindings column: hotkey row needs ~800+ dip after 280 dip settings + delete strip + card padding. -->
				<ColumnDefinition Width="*" MinWidth="820" />
			</Grid.ColumnDefinitions>
			<local:SettingsPanelView Grid.Column="0" DataContext="{Binding vm}" />
			<local:BindingsPanelView Grid.Column="1" DataContext="{Binding vm}" />
		</Grid>
	</DockPanel>
</Window>
