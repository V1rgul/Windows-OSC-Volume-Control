<Window
    x:Class="WindowsOscVolumeControl.ConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WindowsOscVolumeControl"
    Title="Windows OSC Volume Control - Settings"
    Width="980"
    Height="820"
    MinWidth="860"
    MinHeight="700"
    ThemeMode="System"
    PreviewKeyDown="configWindow_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Inline Style without BasedOn drops Fluent chrome (sharp Aero look). -->
        <Style x:Key="OscDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="OscSoftDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource OscDeleteButtonStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding isDeleted}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Binding row: keep horizontal space when soft-deleted (Restore stays aligned). -->
        <Style x:Key="OscBindingSoftDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource OscDeleteButtonStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding isDeleted}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OscRestoreButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding isDeleted}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Custom template so IsMouseOver does not paint over capture highlight (Fluent default template wins over Style triggers). -->
        <Style x:Key="OscHotkeyAssignmentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Focusable="False"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True" />
                                    <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DataContext.isHotkeyCaptureActive}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding isHotkeyCaptureActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="8" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="StatusTextBlock" FontWeight="SemiBold" />
                    <TextBlock x:Name="DiskFeedbackTextBlock" Margin="0,4,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Padding="14,8" Click="buttonReload_Click">Reload from disk</Button>
                    <Button Padding="18,8" FontWeight="SemiBold" Click="buttonApplySaveAndTest_Click">Apply, save and test</Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,8">
                        <GroupBox Header="Autostart" Margin="0,0,0,8" Padding="0">
                            <StackPanel Margin="8,4,8,8" Orientation="Vertical">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Margin="0,0,4,0"
                                        Padding="12,6"
                                        HorizontalAlignment="Stretch"
                                        Click="buttonRegisterAutostart_Click">
                                        Register
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        Padding="12,6"
                                        HorizontalAlignment="Stretch"
                                        Click="buttonDeregisterAutostart_Click">
                                        Deregister
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="AutostartFeedbackTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Config file" Margin="0,0,0,8" Padding="0">
                            <Grid Margin="8,4,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="ConfigPathTextBox" IsReadOnly="True" Margin="0,0,8,4" />
                                <Button Grid.Column="1" Margin="0,0,0,4" Padding="12,6" Click="buttonOpenConfigFolder_Click">Open folder</Button>
                                <TextBlock x:Name="ConfigFeedbackTextBlock" Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Connection" Margin="0,0,0,8" Padding="0">
                            <Grid Margin="8,4,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,0,8,4" VerticalAlignment="Center" Text="OSC IP" />
                                <TextBox x:Name="IpTextBox" Grid.Column="1" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Margin="0,0,8,4" VerticalAlignment="Center" Text="OSC port" />
                                <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Margin="0,0,8,4" VerticalAlignment="Center" Text="Query timeout (ms)" />
                                <TextBox x:Name="TimeoutTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="3" Margin="0,0,8,4" VerticalAlignment="Center" Text="Value cache TTL (ms)" />
                                <TextBox x:Name="CacheTtlTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" />
                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                    <TextBlock x:Name="NetworkFeedbackTextBlock" TextWrapping="Wrap" />
                                    <TextBox x:Name="InfoResultTextBox" Margin="0,4,0,0" MinHeight="96" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="OSD" Margin="0,0,0,8" Padding="0">
                            <Grid Margin="8,4,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,0,8,4" VerticalAlignment="Center" Text="Height (px)" />
                                <TextBox x:Name="OsdHeightTextBox" Grid.Column="1" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Margin="0,0,8,0" VerticalAlignment="Center" Text="Display duration (ms)" />
                                <TextBox x:Name="OsdDurationTextBox" Grid.Row="1" Grid.Column="1" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="Bindings" Padding="0">
                        <StackPanel Margin="8,4,8,8">
                            <ItemsControl ItemsSource="{Binding Bindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:BindingEditor}">
                                        <Border x:Name="BindingOscCardBorder" Margin="0,0,0,8" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="10" Background="{DynamicResource ExpanderHeaderBackground}">
                                                <Expander
                                                    Padding="8"
                                                    Background="{DynamicResource ExpanderHeaderBackground}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    DataContextChanged="bindingCard_Expander_DataContextChanged"
                                                    Expanded="bindingCard_Expander_Expanded"
                                                    Loaded="bindingCard_Expander_Loaded"
                                                    PreviewKeyDown="bindingCard_Expander_PreviewKeyDown"
                                                    PreviewMouseDown="bindingCard_Expander_PreviewMouseDown"
                                                    Unloaded="bindingCard_Expander_Unloaded"
                                                    IsExpanded="{Binding bindingExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <Expander.Header>
                                                        <!-- Delete/Restore before Fluent's header chrome so the expand chevron is rightmost. -->
                                                        <Grid MinHeight="32" HorizontalAlignment="Stretch" Margin="-8,0,8,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox
                                                                Grid.Column="0"
                                                                Margin="8,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Text="{Binding name, UpdateSourceTrigger=PropertyChanged}">
                                                                <TextBox.Style>
                                                                    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding isDeleted}" Value="True">
                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                                <Setter Property="Opacity" Value="0.45" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <Grid
                                                                Grid.Column="1"
                                                                MinWidth="120"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding isDeleted}" Value="True">
                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                                <Setter Property="Opacity" Value="0.45" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="{Binding typeDisplayLabel}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <ComboBox
                                                                    DisplayMemberPath="label"
                                                                    ItemsSource="{Binding typeChoices}"
                                                                    SelectedValue="{Binding type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    SelectedValuePath="value"
                                                                    VerticalAlignment="Center">
                                                                    <ComboBox.Style>
                                                                        <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ComboBox.Style>
                                                                </ComboBox>
                                                            </Grid>
                                                            <StackPanel
                                                                Grid.Column="2"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <Button Margin="0,0,8,0" Padding="10,6" Click="buttonBindingDelete_Click" Content="Delete" Style="{StaticResource OscBindingSoftDeleteButtonStyle}" />
                                                                <Button
                                                                    Padding="10,6"
                                                                    Click="buttonBindingRestore_Click"
                                                                    Content="Restore"
                                                                    Style="{StaticResource OscRestoreButtonStyle}"
                                                                    Tag="{x:Static local:ConfigWindow.BindingCardRestoreTag}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding isDeleted}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                        <Setter Property="Opacity" Value="0.45" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <StackPanel Margin="0,8,0,0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Margin="0,0,8,8" VerticalAlignment="Center" Text="OSC address" />
                                                            <TextBox Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" Text="{Binding address, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Grid.Row="1" Margin="0,0,8,8" VerticalAlignment="Center" Text="Minimum" Visibility="{Binding isFader, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" Text="{Binding minimum, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding isFader, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,8,8" VerticalAlignment="Center" Text="Maximum" Visibility="{Binding isFader, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,8" Text="{Binding maximum, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding isFader, Converter={StaticResource BoolToVisibility}}" />
                                                        </Grid>
                                                        <TextBlock Margin="0,8,0,8" FontWeight="SemiBold" Text="Hotkeys" />
                                                        <ItemsControl ItemsSource="{Binding hotkeys}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type local:HotkeyActionEditor}">
                                                                    <Border Margin="0,0,0,8" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                                                                        <Grid VerticalAlignment="Center">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Grid.Column="0" Background="Transparent" IsEnabled="{Binding isNotDeleted}">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Opacity" Value="1" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding isDeleted}" Value="True">
                                                                                                <Setter Property="Opacity" Value="0.45" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <Grid VerticalAlignment="Center">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" MinWidth="120" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" MinWidth="120" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Hotkey" />
                                                                            <Button
                                                                                Grid.Column="1"
                                                                                Margin="0,0,16,0"
                                                                                Padding="12,6"
                                                                                HorizontalAlignment="Stretch"
                                                                                HorizontalContentAlignment="Center"
                                                                                Tag="{x:Static local:ConfigWindow.HotkeyAssignmentCaptureTag}"
                                                                                Style="{StaticResource OscHotkeyAssignmentButtonStyle}"
                                                                                PreviewKeyDown="hotkeyRow_PreviewKeyDown"
                                                                                GotKeyboardFocus="hotkeyControl_GotKeyboardFocus"
                                                                                LostKeyboardFocus="hotkeyControl_LostKeyboardFocus">
                                                                                <TextBlock Text="{Binding hotkeyText}" TextAlignment="Center">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding isHotkeyIdlePlaceholder}" Value="True">
                                                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Button>
                                                                            <TextBlock Grid.Column="2" Margin="24,0,24,0" VerticalAlignment="Center" Text="Action" />
                                                                            <ComboBox
                                                                                Grid.Column="3"
                                                                                Margin="0,0,8,0"
                                                                                MinWidth="160"
                                                                                HorizontalAlignment="Stretch"
                                                                                DisplayMemberPath="displayName"
                                                                                ItemsSource="{Binding choiceList}"
                                                                                SelectedItem="{Binding selectedChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBox MinWidth="100" Margin="0,0,8,0" Text="{Binding floatValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding showsFloatInput, Converter={StaticResource BoolToVisibility}}" />
                                                                                        <CheckBox VerticalAlignment="Center" Content="On" IsChecked="{Binding boolValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding showsBoolInput, Converter={StaticResource BoolToVisibility}}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                            <StackPanel
                                                                                Grid.Column="1"
                                                                                Margin="12,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                Orientation="Horizontal">
                                                                                <Button
                                                                                    Margin="0,0,8,0"
                                                                                    Padding="10,6"
                                                                                    Click="buttonHotkeyRestore_Click"
                                                                                    Content="Restore"
                                                                                    Style="{StaticResource OscRestoreButtonStyle}" />
                                                                                <Button
                                                                                    Padding="10,6"
                                                                                    Click="buttonHotkeyDelete_Click"
                                                                                    Content="Delete"
                                                                                    Style="{StaticResource OscSoftDeleteButtonStyle}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button HorizontalAlignment="Center" Margin="0,4,0,0" Padding="12,6" Click="buttonAddHotkeyToBinding_Click">Add hotkey</Button>
                                                    </StackPanel>
                                                        <Border Background="#66000000" Visibility="{Binding isDeleted, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" />
                                                    </Grid>
                                                </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Margin="0,8,0,0" Padding="14,8" HorizontalAlignment="Center" Click="buttonAddBinding_Click">Add binding</Button>
                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
