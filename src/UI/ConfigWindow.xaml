<Window
	x:Class="WindowsOscVolumeControl.ConfigWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:WindowsOscVolumeControl"
	Title="Windows OSC Volume Control - Settings"
	Width="1180"
	Height="820"
	MinWidth="1180"
	MinHeight="700"
	ThemeMode="System"
	PreviewKeyDown="configWindow_PreviewKeyDown"
	PreviewKeyUp="configWindow_PreviewKeyUp">
	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<local:DragActivePlaceholderMultiConverter x:Key="DragActivePlaceholderMultiConverter" />
		<!-- Inline Style without BasedOn drops Fluent chrome (sharp Aero look). -->
		<Style x:Key="OscDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
			<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
		</Style>
		<Style x:Key="OscSoftDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource OscDeleteButtonStyle}">
			<Setter Property="Visibility" Value="Visible" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding isDeleted}" Value="True">
					<Setter Property="Visibility" Value="Collapsed" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<!-- Binding row: keep horizontal space when soft-deleted (Restore stays aligned). -->
		<Style x:Key="OscBindingSoftDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource OscDeleteButtonStyle}">
			<Setter Property="Visibility" Value="Visible" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding isDeleted}" Value="True">
					<Setter Property="Visibility" Value="Hidden" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="OscRestoreButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
			<Setter Property="Visibility" Value="Collapsed" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding isDeleted}" Value="True">
					<Setter Property="Visibility" Value="Visible" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<!-- (removed ConfigReloadButtonStyle along with reload button) -->
		<!-- Custom template so IsMouseOver does not paint over capture highlight (Fluent default template wins over Style triggers). -->
		<Style x:Key="OscHotkeyAssignmentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
			<Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="SnapsToDevicePixels" Value="True" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border
							x:Name="Chrome"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="4"
							Padding="{TemplateBinding Padding}"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
							<ContentPresenter
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								Focusable="False"
								RecognizesAccessKey="True" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
							</Trigger>
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True" />
									<Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DataContext.isHotkeyCaptureActive}" Value="False" />
								</MultiDataTrigger.Conditions>
								<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
							</MultiDataTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding isHotkeyCaptureActive}" Value="True">
					<Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
					<Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
					<Setter Property="BorderThickness" Value="1" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<!-- DefaultTextBoxBaseStyle omits Fluent's focus clear (X) button so right-aligned digits do not shift. -->
		<Style x:Key="ConfigNumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxBaseStyle}">
			<Setter Property="TextAlignment" Value="Right" />
		</Style>
	</Window.Resources>
	<DockPanel>
		<Border DockPanel.Dock="Bottom" Padding="8" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
			<DockPanel LastChildFill="False">
				<TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" />
				<Button
					DockPanel.Dock="Right"
					Padding="18,8"
					FontWeight="SemiBold"
					Click="buttonApplySaveAndTest_Click">
					Apply, save and test
				</Button>
			</DockPanel>
		</Border>

		<Grid Margin="8,0,8,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280" />
				<!-- Bindings column: hotkey row needs ~800+ dip after 280 dip settings + delete strip + card padding. -->
				<ColumnDefinition Width="*" MinWidth="820" />
			</Grid.ColumnDefinitions>
			<Border Grid.Column="0" Padding="0">
				<local:SmoothScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="0,0,8,8" Grid.IsSharedSizeScope="True">
						<GroupBox Header="Autostart" Margin="0,0,0,8" Padding="0">
							<StackPanel Margin="8,4,8,8" Orientation="Vertical">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Button
										Grid.Column="0"
										Margin="0,0,4,0"
										Padding="12,6"
										MinHeight="32"
										VerticalAlignment="Stretch"
										VerticalContentAlignment="Center"
										HorizontalAlignment="Stretch"
										Click="buttonRegisterAutostart_Click">
										Register
									</Button>
									<Grid
										Grid.Column="1"
										Margin="4,0,0,0"
										HorizontalAlignment="Stretch"
										MinHeight="32"
										VerticalAlignment="Stretch">
										<Border
											HorizontalAlignment="Stretch"
											VerticalAlignment="Stretch"
											Background="{DynamicResource ControlFillColorDefaultBrush}"
											BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
											BorderThickness="1"
											CornerRadius="4"
											SnapsToDevicePixels="True" />
										<Grid VerticalAlignment="Stretch">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<Button
												Grid.Column="0"
												Padding="12,6"
												VerticalAlignment="Stretch"
												VerticalContentAlignment="Center"
												HorizontalAlignment="Stretch"
												HorizontalContentAlignment="Center"
												Background="Transparent"
												BorderBrush="Transparent"
												BorderThickness="0"
												Click="buttonDeregisterAutostart_Click">
												Deregister
											</Button>
											<Grid Grid.Column="1" VerticalAlignment="Stretch">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>
												<Border
													Grid.Column="0"
													Width="1"
													Margin="0,6,0,6"
													HorizontalAlignment="Center"
													VerticalAlignment="Stretch"
													Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
												<Button
													x:Name="buttonDeregisterAutostartSplitMenu"
													Grid.Column="1"
													MinWidth="30"
													Padding="8,6"
													VerticalAlignment="Stretch"
													VerticalContentAlignment="Center"
													HorizontalAlignment="Stretch"
													Background="Transparent"
													BorderBrush="Transparent"
													BorderThickness="0"
													Click="buttonDeregisterAutostartSplitMenu_Click"
													ToolTip="More autostart options">
													<Button.ContextMenu>
														<ContextMenu>
															<MenuItem
																Header="Deregister All"
																Click="menuItemDeregisterAllAutostart_Click" />
														</ContextMenu>
													</Button.ContextMenu>
													<TextBlock
														FontFamily="{DynamicResource SymbolThemeFontFamily}"
														FontSize="12"
														Text="&#xE70D;"
														VerticalAlignment="Center"
														HorizontalAlignment="Center" />
												</Button>
											</Grid>
										</Grid>
									</Grid>
								</Grid>
								<TextBlock x:Name="AutostartFeedbackTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" />
								<TextBox
									x:Name="AutostartFeedbackPathTextBox"
									Margin="0,4,0,0"
									FontSize="12"
									IsReadOnly="True"
									TextWrapping="Wrap"
									AcceptsReturn="True"
									VerticalScrollBarVisibility="Disabled"
									HorizontalScrollBarVisibility="Disabled"
									Visibility="Collapsed" />
							</StackPanel>
						</GroupBox>

						<GroupBox Header="Config file" Margin="0,0,0,8" Padding="0">
							<Grid Margin="8,4,8,8">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox
									x:Name="ConfigPathTextBox"
									Grid.Row="0"
									Grid.Column="0"
									IsReadOnly="True"
									FontSize="12"
									TextWrapping="Wrap"
									AcceptsReturn="True"
									VerticalScrollBarVisibility="Disabled"
									HorizontalScrollBarVisibility="Disabled"
									Margin="0,0,0,4" />
								<Button
									Grid.Row="0"
									Grid.Column="1"
									Margin="8,0,0,4"
									MinWidth="40"
									Padding="0"
									HorizontalAlignment="Right"
									VerticalAlignment="Stretch"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									Click="buttonOpenConfigFolder_Click"
									ToolTip="Open config folder">
									<TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE838;" />
								</Button>
								<TextBlock
									x:Name="ConfigFeedbackTextBlock"
									Grid.Row="1"
									Grid.ColumnSpan="2"
									TextWrapping="Wrap" />
							</Grid>
						</GroupBox>

						<GroupBox Header="Connection" Margin="0,0,0,8" Padding="0">
							<Grid Margin="8,4,8,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsLabel" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsUnit" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Margin="0,0,4,4" VerticalAlignment="Center" Text="OSC IP" />
								<TextBox x:Name="IpTextBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4" />
								<TextBlock Grid.Row="1" Margin="0,0,4,4" VerticalAlignment="Center" Text="OSC port" />
								<TextBox
									x:Name="PortTextBox"
									Grid.Row="1"
									Grid.Column="1"
									Grid.ColumnSpan="2"
									Margin="0,0,0,4"
									Style="{StaticResource ConfigNumericTextBoxStyle}" />
								<TextBlock Grid.Row="2" Margin="0,0,4,4" VerticalAlignment="Center" Text="Query timeout" />
								<TextBox
									x:Name="TimeoutTextBox"
									Grid.Row="2"
									Grid.Column="1"
									Margin="0,0,0,4"
									Style="{StaticResource ConfigNumericTextBoxStyle}" />
								<TextBlock Grid.Row="2" Grid.Column="2" Margin="4,0,0,4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="ms" />
								<TextBlock Grid.Row="3" Margin="0,0,4,4" VerticalAlignment="Center" Text="Value cache TTL" />
								<TextBox
									x:Name="CacheTtlTextBox"
									Grid.Row="3"
									Grid.Column="1"
									Margin="0,0,0,4"
									Style="{StaticResource ConfigNumericTextBoxStyle}" />
								<TextBlock Grid.Row="3" Grid.Column="2" Margin="4,0,0,4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="ms" />
								<StackPanel Grid.Row="4" Grid.ColumnSpan="3">
									<Grid Margin="0,8,0,6" HorizontalAlignment="Stretch" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" MinWidth="48" />
											<ColumnDefinition Width="*" MinWidth="56" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>

										<TextBlock FontWeight="SemiBold" Margin="0,0,10,0" Text="Latency" TextAlignment="Left" HorizontalAlignment="Left" />
										<TextBlock Grid.Column="1" FontWeight="SemiBold" Margin="0,0,10,0" Text="Ping" TextAlignment="Center" HorizontalAlignment="Stretch" />
										<local:OverflowMarquee Grid.Column="2" Margin="0,0,10,0" HorizontalContentAlignment="Stretch" scrollMode="ONLY_ON_HOVER">
											<TextBlock x:Name="OscHeaderTextBlock" FontWeight="SemiBold" Text="OSC" TextAlignment="Center" HorizontalAlignment="Stretch" />
										</local:OverflowMarquee>
										<TextBlock Grid.Column="3" FontWeight="SemiBold" Text="" TextAlignment="Center" HorizontalAlignment="Stretch" />

										<TextBlock Grid.Row="1" Margin="0,2,10,0" Text="Min" />
										<TextBlock x:Name="PingMinTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,2,10,0" Text="—" TextAlignment="Right" />
										<TextBlock x:Name="OscMinTextBlock" Grid.Row="1" Grid.Column="2" Margin="0,2,10,0" Text="—" TextAlignment="Right" />
										<TextBlock Grid.Row="1" Grid.Column="3" Margin="0,2,0,0" Text="ms" />

										<TextBlock Grid.Row="2" Margin="0,2,10,0" Text="Median" />
										<TextBlock x:Name="PingMedianTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,2,10,0" Text="—" TextAlignment="Right" />
										<TextBlock x:Name="OscMedianTextBlock" Grid.Row="2" Grid.Column="2" Margin="0,2,10,0" Text="—" TextAlignment="Right" />
										<TextBlock Grid.Row="2" Grid.Column="3" Margin="0,2,0,0" Text="ms" />

										<TextBlock Grid.Row="3" Margin="0,2,10,0" Text="Max" />
										<TextBlock x:Name="PingMaxTextBlock" Grid.Row="3" Grid.Column="1" Margin="0,2,10,0" Text="—" TextAlignment="Right" />
										<TextBlock x:Name="OscMaxTextBlock" Grid.Row="3" Grid.Column="2" Margin="0,2,10,0" Text="—" TextAlignment="Right" />
										<TextBlock Grid.Row="3" Grid.Column="3" Margin="0,2,0,0" Text="ms" />

										<TextBlock Grid.Row="4" Margin="0,2,10,0" Text="Responses" />
										<TextBlock x:Name="PingLossTextBlock" Grid.Row="4" Grid.Column="1" Margin="0,2,10,0" Text="—" TextAlignment="Right" />
										<TextBlock x:Name="OscLossTextBlock" Grid.Row="4" Grid.Column="2" Margin="0,2,10,0" Text="—" TextAlignment="Right" />
										<TextBlock x:Name="LossUnitTextBlock" Grid.Row="4" Grid.Column="3" Margin="0,2,0,0" Text="/0" TextAlignment="Left" />
									</Grid>
									<Grid Margin="0,4,0,0" HorizontalAlignment="Stretch">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Margin="0,0,8,0"
											VerticalAlignment="Center"
											FontWeight="SemiBold"
											Text="/info" />
										<TextBox
											x:Name="InfoResultTextBox"
											Grid.Column="1"
											MinLines="1"
											MaxLines="10"
											IsReadOnly="True"
											FontSize="12"
											TextWrapping="Wrap"
											VerticalScrollBarVisibility="Auto"
											HorizontalScrollBarVisibility="Disabled"
											AcceptsReturn="True" />
									</Grid>
								</StackPanel>
							</Grid>
						</GroupBox>

						<GroupBox Header="OSD" Margin="0,0,0,8" Padding="0">
							<Grid Margin="8,4,8,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsLabel" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsUnit" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Margin="0,0,4,4" VerticalAlignment="Center" Text="Height" />
								<TextBox
									x:Name="OsdHeightTextBox"
									Grid.Column="1"
									Margin="0,0,0,4"
									Style="{StaticResource ConfigNumericTextBoxStyle}" />
								<TextBlock Grid.Column="2" Margin="4,0,0,4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="DIP" />
								<TextBlock Grid.Row="1" Margin="0,0,4,4" VerticalAlignment="Center" Text="Display duration" />
								<TextBox
									x:Name="OsdDurationTextBox"
									Grid.Row="1"
									Grid.Column="1"
									Margin="0,0,0,4"
									Style="{StaticResource ConfigNumericTextBoxStyle}" />
								<TextBlock Grid.Row="1" Grid.Column="2" Margin="4,0,0,4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="ms" />
								<TextBlock Grid.Row="2" Margin="0,0,4,0" VerticalAlignment="Center" Text="Position" />
								<ComboBox
									x:Name="OsdPositionComboBox"
									Grid.Row="2"
									Grid.Column="1"
									Grid.ColumnSpan="2"
									DisplayMemberPath="label"
									ItemsSource="{x:Static local:OsdAnchorUiChoices.All}"
									SelectedValuePath="value" />
							</Grid>
						</GroupBox>

						<GroupBox Header="Hotkeys" Margin="0,0,0,8" Padding="0">
							<Grid Margin="8,4,8,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsLabel" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" SharedSizeGroup="ConfigSettingsUnit" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Margin="0,0,4,4" VerticalAlignment="Center" TextWrapping="Wrap" Text="Long-press duration" />
								<TextBox
									x:Name="HotkeyLongPressMsTextBox"
									Grid.Column="1"
									Margin="0,0,0,4"
									Style="{StaticResource ConfigNumericTextBoxStyle}" />
								<TextBlock Grid.Column="2" Margin="4,0,0,4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="ms" />
								<CheckBox
									x:Name="HotkeyOptimizeNonLongPressCheckBox"
									Grid.Row="1"
									Grid.ColumnSpan="3"
									Margin="0,4,0,0">
									<TextBlock TextWrapping="Wrap" Text="Optimize non–long-press hotkeys (fire on key down instead of waiting for key up or duration)" />
								</CheckBox>
								<CheckBox
									x:Name="HotkeySuppressLongPressOnlyCheckBox"
									Grid.Row="2"
									Grid.ColumnSpan="3"
									Margin="0,4,0,0">
									<TextBlock TextWrapping="Wrap" Text="Swallow short presses also for long-press-only hotkeys" />
								</CheckBox>
								<CheckBox
									x:Name="HotkeyAcceptMacroChordKeyOrderCheckBox"
									Grid.Row="3"
									Grid.ColumnSpan="3"
									Margin="0,4,0,0">
									<TextBlock TextWrapping="Wrap" Text="Allow modifier key-up before main key (needed when simulated by macros in fixed order)" />
								</CheckBox>
							</Grid>
						</GroupBox>
					</StackPanel>
				</local:SmoothScrollViewer>
			</Border>
			<Grid Grid.Column="1" Margin="8,0,0,0">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<local:SmoothScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
					<GroupBox Header="Bindings" Margin="0,0,8,0" Padding="0">
						<StackPanel Margin="8,4,8,8">
							<ListBox
								ItemsSource="{Binding Bindings}"
								BorderThickness="0"
								Background="Transparent"
								HorizontalContentAlignment="Stretch"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								AllowDrop="True"
								DragOver="reorderList_DragOver"
								Drop="reorderList_Drop"
								DragLeave="reorderList_DragLeave">
								<ListBox.ItemContainerStyle>
									<Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
										<Setter Property="HorizontalContentAlignment" Value="Stretch" />
										<Setter Property="VerticalContentAlignment" Value="Stretch" />
										<Setter Property="Padding" Value="0" />
										<Setter Property="Margin" Value="0" />
										<Setter Property="BorderThickness" Value="0" />
										<Setter Property="Background" Value="Transparent" />
										<Setter Property="FocusVisualStyle" Value="{x:Null}" />
									</Style>
								</ListBox.ItemContainerStyle>
								<ListBox.ItemTemplate>
									<DataTemplate DataType="{x:Type local:BindingEditor}">
										<Grid>
											<Border
												x:Name="BindingOscCardBorder"
												Margin="0,2,0,2"
												Padding="0"
												BorderThickness="1"
												BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
												CornerRadius="10"
												Background="{DynamicResource ExpanderHeaderBackground}">
												<Expander
													Padding="8"
													Background="{DynamicResource ExpanderHeaderBackground}"
													BorderBrush="Transparent"
													BorderThickness="0"
													HorizontalContentAlignment="Stretch"
													DataContextChanged="bindingCard_Expander_DataContextChanged"
													Expanded="bindingCard_Expander_Expanded"
													Loaded="bindingCard_Expander_Loaded"
													PreviewKeyDown="bindingCard_Expander_PreviewKeyDown"
													PreviewMouseDown="bindingCard_Expander_PreviewMouseDown"
													Unloaded="bindingCard_Expander_Unloaded"
													IsExpanded="{Binding bindingExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
													<Expander.Header>
														<!-- Delete/Restore before Fluent's header chrome so the expand chevron is rightmost. -->
														<Grid MinHeight="32" HorizontalAlignment="Stretch" Margin="-8,0,8,0">
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="Auto" />
																<ColumnDefinition Width="*" />
																<ColumnDefinition Width="Auto" />
																<ColumnDefinition Width="Auto" />
															</Grid.ColumnDefinitions>
															<Thumb
																Grid.Column="0"
																Margin="8,0,0,0"
																Width="32"
																MinWidth="32"
																MinHeight="24"
																VerticalAlignment="Center"
																HorizontalAlignment="Left"
																IsEnabled="{Binding isNotDeleted}"
																Cursor="SizeAll"
																DragStarted="reorderThumb_DragStarted">
																<Thumb.Template>
																	<ControlTemplate TargetType="Thumb">
																		<Border Background="Transparent" Padding="6,4">
																			<Grid Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center">
																				<Border
																					Height="1"
																					VerticalAlignment="Top"
																					Margin="0,3,0,0"
																					Background="{DynamicResource TextFillColorSecondaryBrush}" />
																				<Border
																					Height="1"
																					VerticalAlignment="Top"
																					Margin="0,6,0,0"
																					Background="{DynamicResource TextFillColorSecondaryBrush}" />
																			</Grid>
																		</Border>
																	</ControlTemplate>
																</Thumb.Template>
															</Thumb>
															<TextBox
																Grid.Column="1"
																Margin="8,0,8,0"
																VerticalAlignment="Center"
																Text="{Binding name, UpdateSourceTrigger=PropertyChanged}">
																<TextBox.Style>
																	<Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
																		<Style.Triggers>
																			<DataTrigger Binding="{Binding isDeleted}" Value="True">
																				<Setter Property="IsEnabled" Value="False" />
																				<Setter Property="Opacity" Value="0.45" />
																			</DataTrigger>
																		</Style.Triggers>
																	</Style>
																</TextBox.Style>
															</TextBox>
															<Grid
																Grid.Column="2"
																MinWidth="120"
																Margin="0,0,8,0"
																VerticalAlignment="Center">
																<Grid.Style>
																	<Style TargetType="Grid">
																		<Style.Triggers>
																			<DataTrigger Binding="{Binding isDeleted}" Value="True">
																				<Setter Property="IsEnabled" Value="False" />
																				<Setter Property="Opacity" Value="0.45" />
																			</DataTrigger>
																		</Style.Triggers>
																	</Style>
																</Grid.Style>
																<TextBlock
																	VerticalAlignment="Center"
																	Foreground="{DynamicResource TextFillColorPrimaryBrush}"
																	Text="{Binding typeDisplayLabel}">
																	<TextBlock.Style>
																		<Style TargetType="TextBlock">
																			<Setter Property="Visibility" Value="Collapsed" />
																			<Style.Triggers>
																				<DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="False">
																					<Setter Property="Visibility" Value="Visible" />
																				</DataTrigger>
																			</Style.Triggers>
																		</Style>
																	</TextBlock.Style>
																</TextBlock>
																<ComboBox
																	DisplayMemberPath="label"
																	ItemsSource="{Binding typeChoices}"
																	SelectedValue="{Binding type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
																	SelectedValuePath="value"
																	VerticalAlignment="Center">
																	<ComboBox.Style>
																		<Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
																			<Setter Property="Visibility" Value="Visible" />
																			<Style.Triggers>
																				<DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="False">
																					<Setter Property="Visibility" Value="Collapsed" />
																				</DataTrigger>
																			</Style.Triggers>
																		</Style>
																	</ComboBox.Style>
																</ComboBox>
															</Grid>
															<StackPanel
																Grid.Column="3"
																Margin="0,0,8,0"
																VerticalAlignment="Center"
																Orientation="Horizontal">
																<Button
																	Margin="0,0,8,0"
																	Padding="10,6"
																	Click="buttonBindingDelete_Click"
																	Style="{StaticResource OscBindingSoftDeleteButtonStyle}"
																	ToolTip="Delete">
																	<TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE74D;" />
																</Button>
																<Button
																	Padding="10,6"
																	Click="buttonBindingRestore_Click"
																	Style="{StaticResource OscRestoreButtonStyle}"
																	Tag="{x:Static local:ConfigWindow.BindingCardRestoreTag}"
																	ToolTip="Restore">
																	<TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE7A7;" />
																</Button>
															</StackPanel>
														</Grid>
													</Expander.Header>
													<Grid>
														<Grid.Style>
															<Style TargetType="Grid">
																<Style.Triggers>
																	<DataTrigger Binding="{Binding isDeleted}" Value="True">
																		<Setter Property="IsEnabled" Value="False" />
																		<Setter Property="Opacity" Value="0.45" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</Grid.Style>
														<StackPanel TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
														<Grid>
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="180" />
																<ColumnDefinition Width="*" />
																<ColumnDefinition Width="180" />
																<ColumnDefinition Width="*" />
															</Grid.ColumnDefinitions>
															<Grid.RowDefinitions>
																<RowDefinition Height="Auto" />
																<RowDefinition Height="Auto" />
															</Grid.RowDefinitions>
															<TextBlock Margin="0,0,8,4" VerticalAlignment="Center" Text="OSC address" />
															<TextBox Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4" Text="{Binding address, UpdateSourceTrigger=PropertyChanged}" />
															<TextBlock Grid.Row="1" Margin="0,8,8,4" VerticalAlignment="Center" Text="Minimum" Visibility="{Binding isFader, Converter={StaticResource BoolToVisibility}}" />
															<TextBox
																Grid.Row="1"
																Grid.Column="1"
																Margin="0,8,8,4"
																Style="{StaticResource ConfigNumericTextBoxStyle}"
																Text="{Binding minimum, UpdateSourceTrigger=PropertyChanged}"
																Visibility="{Binding isFader, Converter={StaticResource BoolToVisibility}}" />
															<TextBlock Grid.Row="1" Grid.Column="2" Margin="0,8,8,4" VerticalAlignment="Center" Text="Maximum" Visibility="{Binding isFader, Converter={StaticResource BoolToVisibility}}" />
															<TextBox
																Grid.Row="1"
																Grid.Column="3"
																Margin="0,8,0,4"
																Style="{StaticResource ConfigNumericTextBoxStyle}"
																Text="{Binding maximum, UpdateSourceTrigger=PropertyChanged}"
																Visibility="{Binding isFader, Converter={StaticResource BoolToVisibility}}" />
														</Grid>
														<Border
															Height="1"
															Margin="0,10,0,10"
															Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
														<DockPanel Margin="0,0,0,8" LastChildFill="True">
															<Button
																DockPanel.Dock="Right"
																Margin="8,0,0,0"
																Padding="12,6"
																VerticalAlignment="Center"
																Click="buttonAddHotkeyToBinding_Click"
																ToolTip="Add hotkey">
																<TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE710;" />
															</Button>
															<TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Hotkeys" />
														</DockPanel>
														<ListBox
															ItemsSource="{Binding hotkeys}"
															BorderThickness="0"
															Background="Transparent"
															HorizontalContentAlignment="Stretch"
															ScrollViewer.HorizontalScrollBarVisibility="Disabled"
															AllowDrop="True"
															DragOver="reorderList_DragOver"
															Drop="reorderList_Drop"
															DragLeave="reorderList_DragLeave">
															<ListBox.ItemContainerStyle>
																<Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
																	<Setter Property="HorizontalContentAlignment" Value="Stretch" />
																	<Setter Property="VerticalContentAlignment" Value="Stretch" />
																	<Setter Property="Padding" Value="0" />
																	<Setter Property="Margin" Value="0" />
																	<Setter Property="BorderThickness" Value="0" />
																	<Setter Property="Background" Value="Transparent" />
																	<Setter Property="FocusVisualStyle" Value="{x:Null}" />
																</Style>
															</ListBox.ItemContainerStyle>
															<ListBox.ItemTemplate>
																<DataTemplate DataType="{x:Type local:HotkeyActionEditor}">
																	<Grid>
																		<Border
																			x:Name="HotkeyRowBorder"
																			Margin="0,2,0,2"
																			Padding="8"
																			BorderThickness="1"
																			BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
																			Background="{DynamicResource ControlFillColorSecondaryBrush}"
																			CornerRadius="6">
																		<Grid>
																			<Grid.ColumnDefinitions>
																				<ColumnDefinition Width="*" />
																				<ColumnDefinition Width="Auto" />
																			</Grid.ColumnDefinitions>
																			<Border Grid.Column="0" Background="Transparent" IsEnabled="{Binding isNotDeleted}">
																				<Border.Style>
																					<Style TargetType="Border">
																						<Setter Property="Opacity" Value="1" />
																						<Style.Triggers>
																							<DataTrigger Binding="{Binding isDeleted}" Value="True">
																								<Setter Property="Opacity" Value="0.45" />
																							</DataTrigger>
																						</Style.Triggers>
																					</Style>
																				</Border.Style>
																				<Grid VerticalAlignment="Center">
																					<Grid.ColumnDefinitions>
																						<ColumnDefinition Width="Auto" />
																						<ColumnDefinition Width="Auto" />
																						<!-- Equal * share with action column; keep col min modest so action combo gets room. -->
																						<ColumnDefinition Width="*" MinWidth="80" />
																						<ColumnDefinition Width="Auto" />
																						<ColumnDefinition Width="Auto" />
																						<ColumnDefinition Width="*" MinWidth="200" />
																					</Grid.ColumnDefinitions>
																					<Thumb
																						Grid.Column="0"
																						Margin="0,0,8,0"
																						Width="32"
																						MinWidth="32"
																						MinHeight="24"
																						VerticalAlignment="Center"
																						HorizontalAlignment="Left"
																						IsEnabled="{Binding isNotDeleted}"
																						Cursor="SizeAll"
																						DragStarted="reorderThumb_DragStarted">
																						<Thumb.Template>
																							<ControlTemplate TargetType="Thumb">
																								<Border Background="Transparent" Padding="6,4">
																									<Grid Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center">
																										<Border
																											Height="1"
																											VerticalAlignment="Top"
																											Margin="0,3,0,0"
																											Background="{DynamicResource TextFillColorSecondaryBrush}" />
																										<Border
																											Height="1"
																											VerticalAlignment="Top"
																											Margin="0,6,0,0"
																											Background="{DynamicResource TextFillColorSecondaryBrush}" />
																									</Grid>
																								</Border>
																							</ControlTemplate>
																						</Thumb.Template>
																					</Thumb>
																					<TextBlock Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Text="Hotkey" />
																			<Button
																				Grid.Column="2"
																				Margin="0,0,4,0"
																				Padding="12,6"
																				HorizontalAlignment="Stretch"
																				HorizontalContentAlignment="Center"
																				Tag="{x:Static local:ConfigWindow.HotkeyAssignmentCaptureTag}"
																				Style="{StaticResource OscHotkeyAssignmentButtonStyle}"
																				PreviewKeyDown="hotkeyRow_PreviewKeyDown"
																				PreviewKeyUp="hotkeyRow_PreviewKeyUp"
																				GotKeyboardFocus="hotkeyControl_GotKeyboardFocus"
																				LostKeyboardFocus="hotkeyControl_LostKeyboardFocus">
																				<TextBlock Text="{Binding hotkeyText}" TextAlignment="Center">
																					<TextBlock.Style>
																						<Style TargetType="TextBlock">
																							<Style.Triggers>
																								<DataTrigger Binding="{Binding isHotkeyIdlePlaceholder}" Value="True">
																									<Setter Property="FontStyle" Value="Italic" />
																								</DataTrigger>
																							</Style.Triggers>
																						</Style>
																					</TextBlock.Style>
																				</TextBlock>
																			</Button>
																			<CheckBox
																				Grid.Column="3"
																				MinWidth="0"
																				HorizontalAlignment="Left"
																				HorizontalContentAlignment="Left"
																				VerticalAlignment="Center"
																				VerticalContentAlignment="Center"
																				IsChecked="{Binding longPress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
																				<TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Long press" />
																			</CheckBox>
																			<TextBlock Grid.Column="4" Margin="32,0,8,0" VerticalAlignment="Center" Text="Action" />
																			<Grid Grid.Column="5" MinWidth="200">
																				<!-- Extras dock Right so the combo receives remaining width (Fluent *|Auto measured oddly). -->
																				<DockPanel VerticalAlignment="Center" LastChildFill="True">
																					<StackPanel
																						DockPanel.Dock="Right"
																						Margin="4,0,0,0"
																						HorizontalAlignment="Left"
																						VerticalAlignment="Center"
																						Orientation="Horizontal">
																						<TextBox
																							MinWidth="100"
																							Margin="0,0,8,0"
																							HorizontalAlignment="Left"
																							Style="{StaticResource ConfigNumericTextBoxStyle}"
																							Text="{Binding floatValue, UpdateSourceTrigger=PropertyChanged}"
																							Visibility="{Binding showsFloatInput, Converter={StaticResource BoolToVisibility}}" />
																						<CheckBox
																							MinWidth="0"
																							HorizontalAlignment="Left"
																							HorizontalContentAlignment="Left"
																							VerticalAlignment="Center"
																							VerticalContentAlignment="Center"
																							IsChecked="{Binding boolValue, UpdateSourceTrigger=PropertyChanged}"
																							Visibility="{Binding showsBoolInput, Converter={StaticResource BoolToVisibility}}">
																							<TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="On" />
																						</CheckBox>
																					</StackPanel>
																					<ComboBox
																						Margin="0,0,4,0"
																						MinWidth="120"
																						HorizontalAlignment="Stretch"
																						DisplayMemberPath="displayName"
																						ItemsSource="{Binding choiceList}"
																						SelectedItem="{Binding selectedChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
																				</DockPanel>
																			</Grid>
																				</Grid>
																			</Border>
																			<StackPanel
																				Grid.Column="1"
																				Margin="32,0,0,0"
																				VerticalAlignment="Center"
																				Orientation="Horizontal">
																				<Button
																					Margin="0,0,8,0"
																					Padding="10,6"
																					Click="buttonHotkeyRestore_Click"
																					Style="{StaticResource OscRestoreButtonStyle}"
																					ToolTip="Restore">
																					<TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE7A7;" />
																				</Button>
																				<Button
																					Margin="0"
																					Padding="10,6"
																					Click="buttonHotkeyDelete_Click"
																					Style="{StaticResource OscSoftDeleteButtonStyle}"
																					ToolTip="Delete">
																					<TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE74D;" />
																				</Button>
																			</StackPanel>
																		</Grid>
																		</Border>
																		<Border
																			x:Name="HotkeyDragPlaceholder"
																			Margin="0,2,0,2"
																			Padding="8"
																			BorderThickness="1"
																			BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
																			CornerRadius="6"
																			Background="{DynamicResource ControlFillColorSecondaryBrush}"
																			Opacity="0.35"
																			Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.dragPlaceholderHeight}"
																			Visibility="Collapsed"
																			IsHitTestVisible="False" />
																	</Grid>
																	<DataTemplate.Triggers>
																		<DataTrigger Value="True">
																			<DataTrigger.Binding>
																				<MultiBinding Converter="{StaticResource DragActivePlaceholderMultiConverter}">
																					<Binding />
																					<Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.dragItem" />
																					<Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.isDragInProgress" />
																					<Binding RelativeSource="{RelativeSource AncestorType=ListBox}" />
																					<Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.dragOwnerList" />
																				</MultiBinding>
																			</DataTrigger.Binding>
																			<Setter TargetName="HotkeyRowBorder" Property="Visibility" Value="Collapsed" />
																			<Setter TargetName="HotkeyDragPlaceholder" Property="Visibility" Value="Visible" />
																		</DataTrigger>
																	</DataTemplate.Triggers>
																</DataTemplate>
															</ListBox.ItemTemplate>
														</ListBox>
													</StackPanel>
														<Border Background="#66000000" Visibility="{Binding isDeleted, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" />
													</Grid>
												</Expander>
											</Border>
											<Border
												x:Name="BindingDragPlaceholder"
												Margin="0,2,0,2"
												Padding="0"
												BorderThickness="1"
												BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
												CornerRadius="10"
												Background="{DynamicResource ControlFillColorSecondaryBrush}"
												Opacity="0.35"
												Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.dragPlaceholderHeight}"
												Visibility="Collapsed"
												IsHitTestVisible="False" />
										</Grid>
										<DataTemplate.Triggers>
											<DataTrigger Value="True">
												<DataTrigger.Binding>
													<MultiBinding Converter="{StaticResource DragActivePlaceholderMultiConverter}">
														<Binding />
														<Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.dragItem" />
														<Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.isDragInProgress" />
														<Binding RelativeSource="{RelativeSource AncestorType=ListBox}" />
														<Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.dragOwnerList" />
													</MultiBinding>
												</DataTrigger.Binding>
												<Setter TargetName="BindingOscCardBorder" Property="Visibility" Value="Collapsed" />
												<Setter TargetName="BindingDragPlaceholder" Property="Visibility" Value="Visible" />
											</DataTrigger>
										</DataTemplate.Triggers>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<Button
								Margin="0,8,0,0"
								Padding="14,8"
								HorizontalAlignment="Center"
								Click="buttonAddBinding_Click"
								ToolTip="Add binding">
								<TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE710;" />
							</Button>
						</StackPanel>
					</GroupBox>
				</local:SmoothScrollViewer>
			</Grid>
		</Grid>
	</DockPanel>
</Window>
