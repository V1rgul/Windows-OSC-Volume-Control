<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Inline Style without BasedOn drops Fluent chrome (sharp Aero look). -->
	<Style x:Key="OscDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
		<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
	</Style>
	<Style x:Key="OscSoftDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource OscDeleteButtonStyle}">
		<Setter Property="Visibility" Value="Visible" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding isDeleted}" Value="True">
				<Setter Property="Visibility" Value="Collapsed" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<!-- Binding row: keep horizontal space when soft-deleted (Restore stays aligned). -->
	<Style x:Key="OscBindingSoftDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource OscDeleteButtonStyle}">
		<Setter Property="Visibility" Value="Visible" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding isDeleted}" Value="True">
				<Setter Property="Visibility" Value="Hidden" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="OscRestoreButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
		<Setter Property="Visibility" Value="Collapsed" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding isDeleted}" Value="True">
				<Setter Property="Visibility" Value="Visible" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<!-- Custom template so IsMouseOver does not paint over capture highlight (Fluent default template wins over Style triggers). -->
	<Style x:Key="OscHotkeyAssignmentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
		<Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Chrome"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="4"
						Padding="{TemplateBinding Padding}"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
						<ContentPresenter
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							Focusable="False"
							RecognizesAccessKey="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
						</Trigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True" />
								<Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DataContext.isHotkeyCaptureActive}" Value="False" />
							</MultiDataTrigger.Conditions>
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
						</MultiDataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<DataTrigger Binding="{Binding isHotkeyCaptureActive}" Value="True">
				<Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
				<Setter Property="BorderThickness" Value="1" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<!-- DefaultTextBoxBaseStyle omits Fluent's focus clear (X) button so right-aligned digits do not shift. -->
	<Style x:Key="ConfigNumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxBaseStyle}">
		<Setter Property="TextAlignment" Value="Right" />
		<!-- Suppress default validation adorner (red border). -->
		<Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
		<Style.Triggers>
			<Trigger Property="Validation.HasError" Value="True">
				<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
				<!-- Keep Fluent border chrome unchanged. -->
				<Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="ConfigTextBoxValidationStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxBaseStyle}">
		<!-- Suppress default validation adorner (red border). -->
		<Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
		<Style.Triggers>
			<Trigger Property="Validation.HasError" Value="True">
				<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
				<!-- Keep Fluent border chrome unchanged. -->
				<Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- Read-only display fields: keep selection/copy, but avoid the focused "active input" darkening. -->
	<Style x:Key="ConfigReadOnlyDisplayTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxBaseStyle}">
		<Setter Property="IsReadOnly" Value="True" />
		<Setter Property="IsReadOnlyCaretVisible" Value="False" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<!-- Match Fluent TextBox defaults. -->
		<Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
		<Setter Property="CaretBrush" Value="{DynamicResource TextControlForeground}" />
		<Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource TextControlElevationBorderBrush}" />
		<Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
		<Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
		<Setter Property="MinWidth" Value="{DynamicResource TextControlThemeMinWidth}" />
		<Setter Property="Padding" Value="{DynamicResource TextControlThemePadding}" />
		<Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
		<Setter Property="SelectionBrush" Value="{DynamicResource TextControlSelectionHighlightColor}" />
		<Setter Property="Template" Value="{StaticResource ConfigReadOnlyDisplayTextBoxTemplate}" />
	</Style>
</ResourceDictionary>

