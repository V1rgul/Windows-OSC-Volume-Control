# X32 OSC address → type/range catalog (curated from doc/x32-osc-type-address-details.md).
# Format: one record per line; semicolon-delimited key=value fields.
# The ';' delimiter terminates values. Spaces are allowed only after ';' for visual alignment.
#
# Required fields: address, kind, min, max
# Optional fields: unit
#
# Kinds:
# - level: X32 fader/level curve; real units are dB (BindingLevel.unit is fixed to dB)
# - linf: linear-in-wire float; min/max in real units (unit field is advisory label)
# - logf: log-in-wire float; min/max in real units (unit field is advisory label)

# -------------------------
# level  (all: -90..10 dB)
# -------------------------
address=/config/solo/level;           kind=level; min=-90;      max=10
address=/config/talk/A/level;         kind=level; min=-90;      max=10
address=/config/talk/B/level;         kind=level; min=-90;      max=10
address=/config/osc/level;            kind=level; min=-90;      max=10
address=/ch/[01..32]/mix/mlevel;      kind=level; min=-90;      max=10
address=/ch/[01..32]/mix/[01..16]/level; kind=level; min=-90;   max=10
address=/auxin/[01..08]/mix/mlevel;   kind=level; min=-90;      max=10
address=/auxin/[01..08]/mix/[01..16]/level; kind=level; min=-90; max=10
address=/fxrtn/[01..08]/mix/mlevel;   kind=level; min=-90;      max=10
address=/fxrtn/[01..08]/mix/[01..16]/level; kind=level; min=-90; max=10
address=/ch/[01..32]/mix/fader;       kind=level; min=-90;      max=10
address=/auxin/[01..08]/mix/fader;    kind=level; min=-90;      max=10
address=/fxrtn/[01..08]/mix/fader;    kind=level; min=-90;      max=10
address=/bus/[01..16]/mix/fader;      kind=level; min=-90;      max=10
address=/mtx/[01..06]/mix/fader;      kind=level; min=-90;      max=10
address=/main/st/mix/fader;           kind=level; min=-90;      max=10
address=/main/m/mix/fader;            kind=level; min=-90;      max=10
address=/dca/[1..8]/fader;            kind=level; min=-90;      max=10
address=/bus/[01..16]/mix/mlevel;     kind=level; min=-90;      max=10
address=/bus/[01..16]/mix/[01..06]/level; kind=level; min=-90;  max=10
address=/main/st/mix/[01..06]/level;  kind=level; min=-90;      max=10
address=/main/m/mix/[01..06]/level;   kind=level; min=-90;      max=10

